---
import Base from '../layouts/Base.astro';

const description =
  "A macOS menu bar app that suggests today's Spotify playlist for the mood you are coding in.";
---

<Base title="Sudo Play" description={description}>
  <main>
    <p class="prompt">
      <span class="sigil">$</span> sudo play <span class="flag">--mood</span> friday-deploy
    </p>

    <h1>Sudo Play</h1>

    <p class="lead">{description}</p>

    <p>
      Pick a genre and a mood. It picks the playlist, the same one all day, and a different one
      tomorrow.
    </p>

    <!-- A promise about the app, not this site: keep it attributed (docs/SCOPE.md). -->
    <p>
      Sudo Play has no accounts, no analytics and no tracking. It opens public playlist links and
      nothing else.
    </p>

    <footer>The documentation site is being built. Nothing here yet.</footer>
  </main>
</Base>

<style>
  main {
    width: 100%;
    max-width: 34rem;
  }
  .prompt {
    font-family: ui-monospace, SFMono-Regular, 'SF Mono', Menlo, Consolas, monospace;
    font-size: 0.95rem;
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 14px 16px;
    margin: 0 0 28px;
    overflow-wrap: anywhere;
  }
  .prompt .sigil {
    color: var(--muted);
  }
  .prompt .flag {
    color: var(--accent);
  }
  h1 {
    font-size: 1.5rem;
    margin: 0 0 12px;
    letter-spacing: -0.01em;
  }
  p {
    margin: 0 0 16px;
    color: var(--muted);
  }
  p.lead {
    color: var(--fg);
  }
  footer {
    margin-top: 32px;
    padding-top: 16px;
    border-top: 1px solid var(--line);
    font-size: 0.85rem;
    color: var(--muted);
  }
</style>
