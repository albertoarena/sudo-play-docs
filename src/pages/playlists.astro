---
import Base from '../layouts/Base.astro';
import ExternalLink from '../components/ExternalLink.astro';
import { genres, moods, playlists } from '../data/catalog';
import { shelf } from '../data/shelf';

const app = 'https://github.com/albertoarena/sudo-play';
const genreLabel = (id: string) => genres.find((genre) => genre.id === id)?.label ?? id;
const moodLabel = (id: string) => moods.find((mood) => mood.id === id)?.label ?? id;
// A wide screen shows six covers in the first row; the rest load when scrolled to.
const firstRow = 6;
const groups = shelf();
// Each cover's place on the page, counted across the groups.
const place = new Map(groups.flatMap((group) => group.playlists).map((playlist, index) => [playlist.id, index]));
---
<Base title="Spotify playlists for coding" description={`The ${playlists.length} Spotify playlists Sudo Play picks from, such as Modal debugging and Riffs for risky releases. Choose one to open it in Spotify.`}>
  <h1>Playlists</h1>
  <p class="lead">These are the {playlists.length} playlists in the app's catalog. Choose one to open it in Spotify.</p>

  {groups.map((group) => (
    <section class="group">
      <h2>{group.heading}</h2>
      <ul class="shelf" role="list">
        {group.playlists.map((playlist) => (
          <li class="record">
            <ExternalLink class="record-link" href={playlist.url}>
              <img src={`/covers/${playlist.id}.webp`} width="640" height="640" alt="" decoding="async" loading={place.get(playlist.id)! < firstRow ? undefined : 'lazy'} />
              <span class="record-title">{playlist.title}</span>
            </ExternalLink>
            <p class="record-tags">
              <span class="record-genre">{genreLabel(playlist.genre)}</span>
              <span class="record-moods">{playlist.moods.map((id, i) => <>{i > 0 && ', '}<span class="record-mood">{moodLabel(id)}</span></>)}</span>
            </p>
          </li>
        ))}
      </ul>
    </section>
  ))}

  <h2>Add a playlist</h2>
  <p>Each playlist in the catalog has one genre and one or more moods. Anyone can add a playlist with a pull request. The app's README explains how, in <ExternalLink href={`${app}/blob/main/README.md#adding-a-playlist`}>Adding a playlist</ExternalLink>.</p>
</Base>

<style>
  /* The one block wider than the reading column: each group takes the
     whole frame, centred on the column, its heading on the shelf's edge.
     main is the container. */
  .group {
    width: 100cqi;
    margin-inline: calc((100% - 100cqi) / 2);
  }

  .shelf {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2rem clamp(1rem, 2.5vw, 1.5rem);
    margin: 1.25rem 0 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 36rem) {
    .shelf {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (min-width: 52rem) {
    .shelf {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  @media (min-width: 68rem) {
    .shelf {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }
  }

  .record {
    margin: 0;
    padding: 0;
  }

  /* The cover and the title are the link. The focus ring goes round both. */
  .record-link {
    display: block;
    border-radius: var(--radius);
    color: var(--fg);
    text-decoration: none;
  }

  /* A hairline, as on the app windows, so a bright cover still has an edge
     on a page of any colour. */
  .record-link img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    border-radius: var(--radius);
    outline: 1px solid var(--border);
    outline-offset: -1px;
  }

  .record-title {
    display: block;
    margin-top: 0.75rem;
    font-size: 1rem;
    font-weight: 650;
    line-height: 1.3;
    text-wrap: pretty;
  }

  .record-link:hover .record-title {
    color: var(--accent);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  .record-tags {
    margin: 0.375rem 0 0;
    color: var(--fg-muted);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-variant-ligatures: none;
    line-height: 1.4;
  }

  .record-genre,
  .record-moods {
    display: block;
  }

  /* A narrow cover wraps between moods, never inside a name. */
  .record-mood {
    white-space: nowrap;
  }

  /* Add a playlist ends the page, after the last group. */
  :global(.column) > h2 {
    margin-top: 4rem;
  }
</style>
