---
import Base from '../layouts/Base.astro';
import Placeholder from '../components/Placeholder.astro';
import CodeBlock from '../components/CodeBlock.astro';

// Moved from the How it works mock, so e2e/code.spec.ts has a code block to
// test while no written page has one. See mockPage in e2e/pages.ts.
const catalogEntry = `- id: rock-friday-deploy-01
  title: Placeholder title
  url: https://open.spotify.com/playlist/XXXXXXXXXXXXXXXXXXXXXX
  genre: rock
  moods: [friday-deploy, flow-state]
  curator: your-github-handle`;
---
<Base title="Tips">
  <Placeholder />
  <h1>Tips</h1>
  <p class="lead">Placeholder lead. This page will collect a few tips for using the app.</p>
  <h2>Placeholder heading</h2>
  <p>Placeholder paragraph. Who writes the tips is still open.</p>
  <h2>Placeholder: a code block</h2>
  <p>Placeholder paragraph. Real code, such as a catalog entry, sits in a code block.</p>
  <CodeBlock label="catalog/playlists.yaml" code={catalogEntry} />
</Base>
