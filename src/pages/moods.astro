---
import Base from '../layouts/Base.astro';
import { genres, moods } from '../data/catalog';

const labels = genres.map((genre) => genre.label);
const genreList = `${labels.slice(0, -1).join(', ')} and ${labels.at(-1)}`;
---
<Base title="Pick coding music by mood" description="The coding moods in Sudo Play, such as Debugging, Flow State and Friday Deploy. Choose one and a genre, and the app picks a Spotify playlist for today.">
  <h1>Moods</h1>
  <p class="lead">A mood is how you feel about what you are coding, for example a long debugging session or a Friday deploy. You choose a genre and a mood, and the app picks one Spotify playlist for today.</p>
  <p>The moods and genres come from the app's catalog. The genres are {genreList}.</p>

  <div class="table-wrap">
    <table>
      <thead><tr><th scope="col">Mood</th><th scope="col">Feels like</th></tr></thead>
      <tbody>
        {moods.map((mood) => (
          <tr>
            <td><span aria-hidden="true">{mood.emoji}</span>&nbsp;{mood.label}</td>
            <td>{mood.description}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <p>Every playlist in the catalog, with its genre and moods, is on <a href="/playlists/">Playlists</a>.</p>
</Base>
