---
import Base from '../layouts/Base.astro';
import { releaseNote } from '../data/release';

const app = 'https://github.com/albertoarena/sudo-play';
---
<Base title="Install">
  <h1>Install</h1>
  <p class="lead">Sudo Play is a menu bar app for macOS. {releaseNote()}</p>
  <p>The first release will be a signed DMG attached to a GitHub Release, so it opens without a security warning. Releases are on the app's <a href={`${app}/releases`}>releases page</a>.</p>

  <h2>Build from source</h2>
  <p>Building from source is for contributors. The app's contributing guide explains how to run it and its checks, in <a href={`${app}/blob/main/CONTRIBUTING.md#changing-the-code`}>Changing the code</a>.</p>
</Base>
