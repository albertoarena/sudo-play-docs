---
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/global.css';
import Masthead from '../components/Masthead.astro';
import Footer from '../components/Footer.astro';
import PrevNext from '../components/PrevNext.astro';
import ConsentBanner from '../components/ConsentBanner.astro';
import { gaMeasurementId } from '../data/analytics';

// A page search engines index has a description, which also goes to link
// previews. Only the 404 is noindex: no canonical, no description, no preview.
type Props =
  | {
      // The page's own name. Home passes nothing and is titled with what
      // Sudo Play is, for search results and link previews.
      title?: string;
      // One or two plain sentences, 160 characters at most.
      description: string;
      noindex?: false;
    }
  | { title: string; noindex: true };

const { title } = Astro.props;
const fullTitle = title ? `${title} · Sudo Play` : "Sudo Play: today's Spotify playlist for your coding mood";
const canonical = new URL(Astro.url.pathname, Astro.site);
// One preview image for every page, drawn by `npm run og:image`.
const image = new URL('/og.png', Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    {Astro.props.noindex ? (
      <meta name="robots" content="noindex" />
    ) : (
      <>
        <meta name="description" content={Astro.props.description} />
        <meta name="author" content="Alberto Arena" />
        <link rel="canonical" href={canonical} />
        <meta property="og:type" content="website" />
        <meta property="og:site_name" content="Sudo Play" />
        <meta property="og:title" content={fullTitle} />
        <meta property="og:description" content={Astro.props.description} />
        <meta property="og:url" content={canonical} />
        <meta property="og:locale" content="en" />
        <meta property="og:image" content={image} />
        <meta property="og:image:type" content="image/png" />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content="A dark terminal with the Sudo Play tagline in green: sudo play, genre rock, mood debugging." />
        <meta name="twitter:card" content="summary_large_image" />
      </>
    )}
    <link rel="preload" href="/fonts/geist-mono/geist-mono-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <script is:inline>
      // The theme the visitor chose, before the first paint. With no choice, the system decides.
      try { const theme = localStorage.getItem('sudoplay-theme'); if (theme === 'light' || theme === 'dark') document.documentElement.dataset.theme = theme; } catch {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>
    {Astro.slots.has('masthead') ? (
      <Masthead><slot name="masthead" /></Masthead>
    ) : (
      <Masthead />
    )}
    <main id="content">
      <div class="column">
        <slot />
      </div>
      <PrevNext />
    </main>
    <Footer />
    {gaMeasurementId && <ConsentBanner />}
    <script is:inline>
      // The theme toggle in the masthead: light, dark, then system. Light and
      // dark stay in the browser. System removes the choice.
      (() => {
        const root = document.documentElement;
        const toggle = document.querySelector('.theme-toggle');
        if (!toggle) return;
        const system = '(prefers-color-scheme: dark)';
        // A picture picks its dark source with a media query, which cannot
        // see the choice, so a choice rewrites the query.
        const sources = [...document.querySelectorAll(`picture source[media="${system}"]`)];
        const order = ['light', 'dark', 'system'];
        const mode = () => root.dataset.theme || 'system';
        const show = () => {
          const current = mode();
          toggle.dataset.mode = current;
          toggle.setAttribute('aria-label', `Theme: ${current}`);
          toggle.title = `Theme: ${current}`;
          for (const source of sources) source.media = { system, dark: 'all', light: 'not all' }[current];
        };
        toggle.hidden = false;
        show();
        toggle.addEventListener('click', () => {
          const next = order[(order.indexOf(mode()) + 1) % order.length];
          if (next === 'system') delete root.dataset.theme;
          else root.dataset.theme = next;
          try { next === 'system' ? localStorage.removeItem('sudoplay-theme') : localStorage.setItem('sudoplay-theme', next); } catch {}
          show();
        });
      })();
    </script>
  </body>
</html>
