---
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/global.css';
import Masthead from '../components/Masthead.astro';
import Footer from '../components/Footer.astro';
import PrevNext from '../components/PrevNext.astro';

interface Props {
  // The page's own name. Home passes nothing and is titled "Sudo Play".
  title?: string;
}

const { title } = Astro.props;
const fullTitle = title ? `${title} · Sudo Play` : 'Sudo Play';
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <link rel="canonical" href={canonical} />
    <link rel="preload" href="/fonts/geist-mono/geist-mono-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>
    {Astro.slots.has('masthead') ? (
      <Masthead><slot name="masthead" /></Masthead>
    ) : (
      <Masthead />
    )}
    <main id="content">
      <div class="column">
        <slot />
      </div>
      <PrevNext />
    </main>
    <Footer />
    <script is:inline>
      // The site's own script, and its only one: a Copy button on each code
      // block. Nothing is fetched. Without JavaScript there is no button.
      for (const block of document.querySelectorAll('figure.code-block')) {
        const actions = document.createElement('div');
        const status = document.createElement('span');
        const button = document.createElement('button');
        actions.className = 'code-actions';
        status.className = 'copy-status';
        status.setAttribute('role', 'status');
        button.className = 'copy';
        button.type = 'button';
        button.textContent = 'Copy';
        button.addEventListener('click', async () => {
          try {
            await navigator.clipboard.writeText(block.querySelector('pre').textContent);
            status.textContent = 'Copied';
          } catch {
            status.textContent = 'Copy failed. Select the code instead.';
          }
          setTimeout(() => (status.textContent = ''), 3000);
        });
        actions.append(status, button);
        block.append(actions);
      }
    </script>
  </body>
</html>
