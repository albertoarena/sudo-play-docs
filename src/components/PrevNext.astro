---
import { neighbours } from '../data/nav';

const { previous, next } = neighbours(Astro.url.pathname);
---
{(previous || next) && (
  <nav class="prev-next" aria-label="Previous and next">
    {previous && (
      <a class="prev" href={previous.href} rel="prev">
        <span class="dir">Previous</span>
        <span class="name">{previous.label}</span>
      </a>
    )}
    {next && (
      <a class="next" href={next.href} rel="next">
        <span class="dir">Next</span>
        <span class="name">{next.label}</span>
      </a>
    )}
  </nav>
)}

<style>
  .prev-next {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    max-width: var(--measure);
    margin: 4rem auto 0;
  }

  a {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
    text-decoration: none;
  }

  .next {
    grid-column: 2;
    align-items: flex-end;
    text-align: right;
  }

  .dir {
    color: var(--fg-muted);
    font-size: 0.8125rem;
  }

  .name {
    color: var(--fg);
    font-weight: 650;
  }

  a:hover .name {
    color: var(--accent);
  }

  a:hover {
    border-top-color: var(--accent);
  }
</style>
