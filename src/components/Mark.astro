---
// The Sudo Play mark: a dim prompt and three green equaliser bars. The paths
// are the app icon's, from public/favicon.svg, cropped to the mark itself.
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---
<svg class={className} viewBox="2 4 40 26" aria-hidden="true" focusable="false">
  <path d="M4.6 8.4 13.2 16 4.6 23.6" fill="none" stroke="var(--term-dim)" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round" />
  <g fill="var(--term-green)">
    <rect x="20" y="18" width="4" height="10" rx="1" />
    <rect x="28" y="6" width="4" height="22" rx="1" />
    <rect x="36" y="12" width="4" height="16" rx="1" />
  </g>
</svg>
