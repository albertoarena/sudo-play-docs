---
import ConsentSettings from './ConsentSettings.astro';
import { gaMeasurementId } from '../data/analytics';

const app = 'https://github.com/albertoarena/sudo-play';
const links = [
  { href: app, label: 'Sudo Play on GitHub' },
  { href: `${app}/blob/main/README.md`, label: 'README' },
  { href: `${app}/blob/main/CONTRIBUTING.md`, label: 'Contributing' },
  { href: `${app}/blob/main/PRIVACY.md`, label: 'App privacy' },
];
---
<footer class="site-footer">
  <div class="footer-inner">
    <nav aria-label="The app">
      <ul>
        {links.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
      </ul>
    </nav>
    <div class="footer-end">
      {gaMeasurementId && <ConsentSettings />}
      <p>Sudo Play is not affiliated with Spotify.</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--border);
    color: var(--fg-muted);
    font-size: 0.875rem;
  }

  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem 2rem;
    max-width: var(--frame);
    margin-inline: auto;
    padding: 2rem var(--gutter) calc(2rem + var(--banner-space));
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    margin: 0;
    padding: 0;
  }

  a {
    color: var(--fg);
  }

  a:hover {
    color: var(--accent);
  }

  .footer-end {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 1.5rem;
  }

  p {
    margin: 0;
  }
</style>
