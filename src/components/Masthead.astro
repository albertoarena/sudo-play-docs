---
import Mark from './Mark.astro';
import { home, navPages, normalise } from '../data/nav';

const current = normalise(Astro.url.pathname);
const isHome = current === home.href;
---
<header class="masthead">
  <div class="masthead-inner">
    <a class="brand" href={home.href} aria-current={isHome ? 'page' : undefined}>
      <Mark class="brand-mark" />
      <span>Sudo Play</span>
    </a>
    <nav class="site-nav" aria-label="Site">
      <ul>
        {navPages.map((page) => (
          <li>
            <a href={page.href} aria-current={page.href === current ? 'page' : undefined}>
              {page.label}
              {page.href === current && (
                <span class="here" aria-hidden="true"><i></i><i></i><i></i></span>
              )}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <button class="theme-toggle" type="button" data-mode="system" aria-label="Theme: system" title="Theme: system" hidden>
      <svg class="sun" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" aria-hidden="true"><circle cx="8" cy="8" r="3" /><path d="M8 1.5v1.5M8 13v1.5M1.5 8H3M13 8h1.5M3.4 3.4l1 1M11.6 11.6l1 1M3.4 12.6l1-1M11.6 4.4l1-1" /></svg>
      <svg class="moon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M13.5 9.5A5.5 5.5 0 0 1 6.5 2.5a5.5 5.5 0 1 0 7 7Z" /></svg>
      <svg class="screen" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="3" width="12" height="8" rx="1" /><path d="M5.5 13.5h5M8 11v2.5" /></svg>
    </button>
  </div>
</header>
{Astro.slots.has('default') && (
  <section class="masthead-band" aria-labelledby="tagline">
    <div class="masthead-hero"><slot /></div>
  </section>
)}

<style>
  /* Home's hero sits in its own band after the header, so that only the
     row is pinned and the panel scrolls away under it. Outside the header
     the band needs a landmark of its own, named by the panel's line. */
  .masthead,
  .masthead-band {
    background: var(--term-bg);
    color: var(--term-dim);
    border-bottom: 1px solid var(--band-edge);
  }

  /* On a wide screen the row stays at the top while the page scrolls.
     Stacked below 48rem it is about 120px, so there it scrolls away. Under
     the consent banner and the skip link. */
  @media (min-width: 48rem) {
    .masthead {
      position: sticky;
      top: 0;
      z-index: 4;
    }
  }

  .masthead :focus-visible {
    outline-color: var(--term-focus);
  }

  .masthead-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    column-gap: 2rem;
    max-width: var(--frame);
    min-height: 3.5rem;
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  .masthead-hero {
    max-width: var(--frame);
    margin-inline: auto;
    padding: clamp(1.25rem, 4vw, 3rem) var(--gutter) clamp(2.5rem, 7vw, 4.5rem);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    padding-block: 0.875rem;
    color: var(--term-fg);
    font-size: 0.9375rem;
    font-weight: 650;
    letter-spacing: -0.01em;
    text-decoration: none;
  }

  .brand:hover {
    color: var(--term-fg);
  }

  .brand :global(.brand-mark) {
    width: 1.75rem;
    height: auto;
    flex: none;
  }

  .site-nav {
    margin-inline-start: auto;
  }

  /* The theme toggle, at the end of the row. It shows only when its script
     in Base.astro runs, and its icon is the current mode. */
  .theme-toggle {
    display: grid;
    place-items: center;
    flex: none;
    width: 2rem;
    height: 2rem;
    padding: 0;
    border: 1px solid var(--term-dots);
    border-radius: 6px;
    background: transparent;
    color: var(--term-dim);
    cursor: pointer;
  }

  .theme-toggle[hidden] {
    display: none;
  }

  .theme-toggle:hover {
    color: var(--term-fg);
  }

  .theme-toggle svg {
    display: none;
    width: 1rem;
    height: 1rem;
  }

  .theme-toggle[data-mode='light'] .sun,
  .theme-toggle[data-mode='dark'] .moon,
  .theme-toggle[data-mode='system'] .screen {
    display: block;
  }

  .site-nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-nav li {
    margin: 0;
    padding: 0;
  }

  .site-nav a {
    position: relative;
    display: block;
    padding-block: 1.125rem;
    color: var(--term-dim);
    font-size: 0.9375rem;
    text-decoration: none;
  }

  .site-nav a:hover {
    color: var(--term-fg);
  }

  .site-nav a[aria-current='page'] {
    color: var(--term-green);
  }

  /* You are here: the mark's three equaliser bars, small, under the link. */
  .here {
    position: absolute;
    bottom: 0.4375rem;
    left: 50%;
    display: flex;
    align-items: flex-end;
    gap: 2px;
    height: 6px;
    transform: translateX(-50%);
  }

  .here i {
    width: 3px;
    border-radius: 1px;
    background: var(--term-green);
  }

  .here i:nth-child(1) { height: 45%; }
  .here i:nth-child(2) { height: 100%; }
  .here i:nth-child(3) { height: 73%; }

  /* Stacked: the name and the toggle share the first line, and the nav
     wraps under them. Below 48rem the one row no longer fits. */
  @media (max-width: 47.9375rem) {
    .brand {
      flex: 1;
    }

    /* The brand has less padding below than above here, so the toggle
       steps down to line up with the mark. */
    .theme-toggle {
      order: 1;
      margin-top: 0.625rem;
    }

    .site-nav {
      order: 2;
      flex-basis: 100%;
    }

    .brand {
      padding-bottom: 0.25rem;
    }

    .site-nav ul {
      column-gap: 1.25rem;
    }

    .site-nav a {
      padding-block: 0.375rem 0.6875rem;
      line-height: 1.4;
    }

    .here {
      bottom: 0.1875rem;
    }

  }

  /* On the narrowest phones the seven links wrap three over four, so no
     row strands one. e2e/narrow.spec.ts checks it at 320 and 352px. */
</style>
