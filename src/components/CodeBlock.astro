---
// Real code, the kind a reader types or pastes: labelled with its file or
// language. The Copy button is added by the script in Base.astro, so without
// JavaScript there is no button that does nothing.
interface Props {
  label: string;
  code: string;
}

const { label, code } = Astro.props;
---
<figure class="code-block">
  <figcaption>{label}</figcaption>
  <pre><code>{code}</code></pre>
</figure>

<style>
  .code-block {
    position: relative;
    margin: 1.5rem 0;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-subtle);
  }

  figcaption {
    padding: 0.625rem 6.5rem 0.625rem 1.25rem;
    border-bottom: 1px solid var(--border);
    color: var(--fg-muted);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1.4;
    overflow-wrap: anywhere;
  }

  pre {
    margin: 0;
    border: 0;
    border-radius: 0 0 var(--radius) var(--radius);
  }

  .code-block :global(.code-actions) {
    position: absolute;
    top: 0.3125rem;
    right: 0.5rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .code-block :global(.copy) {
    min-height: 1.75rem;
    padding: 0.25rem 0.625rem;
    border: 1px solid var(--border-strong);
    border-radius: 6px;
    background: var(--bg);
    color: var(--fg);
    font: 500 0.75rem/1 var(--font-sans);
    cursor: pointer;
  }

  .code-block :global(.copy:hover) {
    border-color: var(--fg);
  }

  .code-block :global(.copy-status) {
    color: var(--fg-muted);
    font-size: 0.75rem;
  }
</style>
